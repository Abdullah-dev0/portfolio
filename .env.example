# ===========================================
# PORTFOLIO - ENVIRONMENT VARIABLES
# ===========================================
# Copy this file to .env and fill in your values

# ===========================================
# REQUIRED VARIABLES
# ===========================================

# Your portfolio URL
NEXT_PUBLIC_URL=http://localhost:3000

# Google Gemini AI API Key (for AI chat feature)
# Get it from: https://makersuite.google.com/app/apikey
GEMINI_API_KEY=your_gemini_api_key_here

# Upstash Redis (for rate limiting)
# Get it from: https://upstash.com/ (Create a Redis database)
KV_REST_API_URL=your_upstash_redis_url_here
KV_REST_API_TOKEN=your_upstash_token_here
KV_REST_API_READ_ONLY_TOKEN=your_upstash_read_only_token_here
KV_URL=your_upstash_redis_connection_url_here
REDIS_URL=your_upstash_redis_connection_url_here

# ===========================================
# OPTIONAL VARIABLES
# ===========================================

# PostHog Analytics (optional)
# Get it from: https://posthog.com/
NEXT_PUBLIC_POSTHOG_KEY=your_posthog_key_here
NEXT_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com

# Header visitor totals (server-only; never prefix the personal key with NEXT_PUBLIC_)
POSTHOG_PROJECT_ID=your_posthog_project_id
POSTHOG_PERSONAL_API_KEY=your_posthog_personal_key_with_query_read_permission
# NEXT_PUBLIC_URL must be the production URL to filter visitor totals correctly.
# Existing Upstash Redis credentials above also power online presence and caching.

# Discord Lanyard (for Discord presence - optional)
# Shows your Discord status on your portfolio
LANYARD_API_KEY=your_lanyard_api_key_here
LANYARD_USER_ID=your_discord_user_id_here

# ===========================================
# COMMENTS (giscus)
# ===========================================

# GitHub Discussions-powered comments on blog posts (optional).
# All four values are required together - the comments section is hidden
# unless every one of them is set. Generate them at https://giscus.app
# after installing the giscus GitHub App and enabling Discussions.
NEXT_PUBLIC_GISCUS_REPO=your_github_username/your_repo_name
NEXT_PUBLIC_GISCUS_REPO_ID=your_giscus_repo_id_here
NEXT_PUBLIC_GISCUS_CATEGORY=your_giscus_category_here
NEXT_PUBLIC_GISCUS_CATEGORY_ID=your_giscus_category_id_here

# ===========================================
# DEVELOPMENT VARIABLES
# ===========================================

# Environment (development, production)
NODE_ENV=development

# ===========================================
# VERCEL DEPLOYMENT (Auto-generated by Vercel)
# ===========================================

# These are automatically set by Vercel when deployed
# VERCEL_OIDC_TOKEN=auto_generated_by_vercel
